# Secrets / env — NEVER commit
.env
.env.*
!.env.example
frontend/.env.local
/secrets/
infra/secrets/
*-sa.json

# Docker Desktop creates empty host-side placeholders for the api-test read-only file
# mounts (the container sees the real ro-mounted content) — never commit them.
backend/FIX.md
backend/.gitignore

# Terraform
*.tfstate
*.tfstate.*
.terraform/
# Plan files embed variable values (incl. anything sensitive) — never commit them (D4).
*.tfplan
aegisops*.tfplan
terraform.tfstate.d/
crash.log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
# Playwright saved auth state (contains a live session cookie)
frontend/e2e/.auth/

# Misc
.DS_Store
*.log
