# ════════════════════════════════════════════════════════════════════════
#  AegisOps — environment configuration
#  Copy to ".env" and fill in. NEVER commit the filled .env. No secret in code.
# ════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string
RATE_LIMIT_PER_MINUTE=120

# ── Frontend (put in frontend/.env.local) ────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=aegisops
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=aegisops-frontend

# ── LLM: Google Gemini ───────────────────────────────────────────────────
# gemini-3.5-flash is the current GA flash model (alias: gemini-flash-latest).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
STREAM_WORD_DELAY_MS=24
# USD per 1M tokens — used only to report cost on Langfuse generations.
GEMINI_COST_PER_1M_INPUT=0.30
GEMINI_COST_PER_1M_OUTPUT=2.50

# COST: monthly-USD guardrail for the approval card (0/unset = off). Breach = a FAILED
# policy check the approver sees; estimates come from the static catalog in agents/cost.py.
AEGISOPS_COST_GUARDRAIL_USD=0

# ── PostgreSQL + pgvector (docker-compose default) ───────────────────────
# POSTGRES_PORT is the HOST-published port only (compose maps ${POSTGRES_PORT}:5432).
# 5433 avoids a native Windows PostgreSQL service shadowing 5432 on the host.
# Containers always reach the DB at postgres:5432 on the compose network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aegisops
POSTGRES_USER=aegisops
POSTGRES_PASSWORD=aegisops
DATABASE_URL=postgresql+psycopg://aegisops:aegisops@localhost:5433/aegisops

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j (context graph) ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aegisops-neo4j

# ── Keycloak (OIDC auth + RBAC) ──────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
# Browser-facing Keycloak origin for the SSO redirect (the containerized API reaches
# Keycloak as http://keycloak:8080, which the browser cannot resolve).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Browser-facing Langfuse origin for trace deep-links (in-compose host is http://langfuse:3000).
LANGFUSE_PUBLIC_URL=http://localhost:3001
KEYCLOAK_REALM=aegisops
KEYCLOAK_CLIENT_ID=aegisops-backend
# Matches the secret in infra/keycloak/realm-export.json for local boot. ROTATE for any
# non-local environment (set a new secret in Keycloak and here).
KEYCLOAK_CLIENT_SECRET=aegisops-backend-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Langfuse (LLM observability) ─────────────────────────────────────────
# Langfuse v2 auto-provisions an org/project + these API keys on first boot, so the
# backend connects with no manual UI step. These MUST be keys of the `aegisops`
# project — a key from another project sends traces where the dashboard never sees them.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-aegisops-local
LANGFUSE_SECRET_KEY=sk-lf-aegisops-local
LANGFUSE_INIT_USER_EMAIL=admin@aegisops.local
LANGFUSE_INIT_USER_PASSWORD=aegisops-admin

# ── OpenTelemetry / Prometheus / Grafana ─────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegisops-api
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3002
GRAFANA_PASSWORD=admin

# ── Kubernetes (containerized api mounts this kubeconfig read-only) ───────
# Point at a real kubeconfig to enable K8s workflows; defaults to an empty one.
KUBECONFIG_HOST=./infra/kube/empty-kubeconfig

# ── AWS (read-only discovery + Terraform provider) ───────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required for TEMPORARY / sandbox credentials (keys starting with ASIA…, e.g. from
# `aws sts get-session-token` or AWS Academy/Learner Lab). Leave blank for long-lived IAM keys.
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
# Optional remote TF state backend:
TF_STATE_BUCKET=
TF_STATE_DYNAMODB_TABLE=
TF_STATE_REGION=us-east-1

# ── Azure ────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── GCP ──────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json   # mount the SA json; do not paste keys here

# ── VMware vCenter ───────────────────────────────────────────────────────
VCENTER_HOST=
VCENTER_USER=
VCENTER_PASSWORD=
VCENTER_INSECURE=false

# ── Kubernetes ───────────────────────────────────────────────────────────
KUBECONFIG=/root/.kube/config        # mount your kubeconfig

# ── GitHub (DevOps agent) ────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_ORG=

# ── ServiceNow (ITSM) ────────────────────────────────────────────────────
# IMPORTANT: the password that shipped in the project's ServiceNow doc is LEAKED.
# Rotate it in ServiceNow, then put the NEW value here. Never hard-code it anywhere.
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# ── GW-1: Telegram gateway (message AegisOps from your phone) ────────────
# OFF by default. `on` starts a long-poll loop in the API lifespan — no public URL, no webhook,
# no inbound port. Turning it on with an empty token leaves it off and logs why.
AEGISOPS_TELEGRAM=off
# From @BotFather → /newbot. Treat it as a secret: it is the bot's full credential.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT_S=25
# There is deliberately NO allowlist env var. A chat id is not an authenticated principal:
# identity comes ONLY from a one-time code a web-authenticated user issues in
# Settings → Connected accounts, which binds their Telegram account to their Keycloak user.
# An unlinked sender receives the how-to-link reply and nothing else. RBAC and org scope
# then follow the bound user on every message and every button press.
GATEWAY_LINK_CODE_TTL_SECONDS=600
# Progressive-answer streaming throttle (Telegram rate-limits message edits).
GATEWAY_EDIT_MIN_INTERVAL_MS=1000
GATEWAY_EDIT_MIN_CHARS=50
# Browser-facing web origin used for the deep links sent to a chat ("open in AegisOps").
# Empty ⇒ the first CORS origin. Set this when the browser origin differs from the API's view.
WEB_PUBLIC_URL=

# ── Email / notifications ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=aegisops@yourcompany.com

# ── Terraform / Ansible execution ────────────────────────────────────────
TERRAFORM_BIN=terraform
ANSIBLE_BIN=ansible-playbook
TERRAFORM_WORKSPACES_DIR=./infra/terraform-workspaces
# Execution policy: dry_run | plan | apply | destroy are selected per-request,
# but apply/destroy ALWAYS require human approval regardless of this default.
DEFAULT_EXECUTION_MODE=plan

# ── P1 LLM providers (multi-provider substrate) ─────────────────────────────
# The model catalog lives in backend/app/llm/config/models.yaml (what CAN run);
# per-org routing overrides live in the model_bindings table (Settings → Model
# routing). A provider with no key lists in the catalog but never routes — the
# menu shows it disabled and binding to it is refused as a dead end.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (empty = api.openai.com). OpenRouter is its own
# provider below and does NOT use this.
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
# P1.6 org daily LLM budget gate, USD (0 = off). When exceeded, NEW model calls are
# refused loudly (aegisops_llm_budget_refusals_total) until the UTC day rolls.
AEGISOPS_LLM_DAILY_BUDGET_USD=0

# ── P0 governance / coordination / worker posture ──────────────────────────
# Approval model: single-user HUMAN-IN-THE-LOOP. The initiating human reviews and
# approves or rejects their own plan (initiator == approver). The active posture is
# stamped on every approval card and /healthz — it can never drift silently.
# Shared coordination: redis (required for any non-local / multi-replica posture —
# startup REFUSES a non-local memory bus) | memory (explicit dev/unit-test mode).
AEGISOPS_EVENT_BUS=redis
# Process role: all (single node) | api (no background sweeps) | worker (owns
# reconciler/retention/drift/gateway pollers). Exactly one process should sweep.
AEGISOPS_ROLE=all
# GET /metrics bearer token. Required outside app_env=local (403 when unset there);
# empty keeps the local compose Prometheus scrape open.
AEGISOPS_METRICS_TOKEN=
# Authoritative usage-ledger spill journal (fsync'd; replayed by the reconciler;
# gitignored — never commit it).
AEGISOPS_LEDGER_SPILL_PATH=./llm_usage_spill.jsonl
